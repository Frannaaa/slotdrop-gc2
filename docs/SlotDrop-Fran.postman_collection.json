{
  "info": {
    "name": "SlotDrop — Fran GC2 APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run against a fresh fictional demo database. Set baseUrl to the deployed URL for final evidence. Covers Fran-owned APIs; booking creation, quote and confirmation-by-ID remain team integration work. No response screenshots or deployed results are claimed by this export."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "createdSlotId",
      "value": ""
    },
    {
      "key": "serviceId",
      "value": "1"
    },
    {
      "key": "knownSlotId",
      "value": "1"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"Create a session using the activity cutoff\") {",
          "  pm.collectionVariables.set(\"newSessionStart\", new Date(Date.now()+24*60*60*1000).toISOString());",
          "  pm.collectionVariables.set(\"newSessionCutoff\", new Date(Date.now()+22*60*60*1000).toISOString());",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Read and reconcile",
      "item": [
        {
          "name": "Starter health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Discover released seats",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/slots?people=2&category=creative"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"List is an array\",()=>pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Known session detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/slots/{{knownSlotId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown session",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/slots/900000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Malformed ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/slots/not-an-id"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "No matching search",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/slots?q=NO_MATCH_gc2_check_73f2"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Empty array\",()=>pm.expect(pm.response.json()).to.eql([]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid people quantity",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/slots?people=0"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Repeated filter rejected",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/slots?people=2&people=3"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Owner catalog includes managed inventory",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/owner/catalog"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Saved booking list",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/bookings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"savedBookings\",JSON.stringify(pm.response.json()));"
                ]
              }
            }
          ]
        },
        {
          "name": "Owner metrics reconcile to saved confirmed receipts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/metrics"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const confirmed=JSON.parse(pm.collectionVariables.get(\"savedBookings\")||\"[]\").filter(row=>row.status===\"confirmed\");",
                  "const metrics=pm.response.json();",
                  "pm.test(\"Booking count\",()=>pm.expect(metrics.bookingCount).to.eql(confirmed.length));",
                  "pm.test(\"Modeled commission sum\",()=>pm.expect(metrics.platformRevenueCentavos).to.eql(confirmed.reduce((sum,row)=>sum+row.platformFeeCentavos,0)));",
                  "pm.test(\"Average whole-booking value\",()=>pm.expect(metrics.averageOrderValueCentavos).to.eql(confirmed.length?Math.round(confirmed.reduce((sum,row)=>sum+row.totalPriceCentavos,0)/confirmed.length):0));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Create, pause, edit and resume a fictional session",
      "item": [
        {
          "name": "Create a session using the activity cutoff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/slots",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": 1,\n  \"startsAt\": \"{{newSessionStart}}\",\n  \"capacity\": 4,\n  \"originalPriceCentavos\": 200000,\n  \"offerPriceCentavos\": 160000,\n  \"buddyPriceCentavos\": 152000,\n  \"runsAsScheduled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"createdSlotId\",String(pm.response.json().id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pause the created session",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/slots/{{createdSlotId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"paused\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject a buddy rate above the offer",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/slots/{{createdSlotId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"buddyPriceCentavos\": 170000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Lower offer and disable buddy atomically",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/slots/{{createdSlotId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offerPriceCentavos\": 150000,\n  \"buddyPriceCentavos\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Close the booking deadline",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/slots/{{createdSlotId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingClosesAt\": \"2020-01-01T00:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refuse misleading resumption after cutoff",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/slots/{{createdSlotId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"open\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Set a future cutoff and resume",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/slots/{{createdSlotId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"bookingClosesAt\":\"{{newSessionCutoff}}\",\"status\":\"open\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Invalid input",
      "item": [
        {
          "name": "Missing required session fields",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/slots",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Malformed JSON",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/slots",
            "body": {
              "mode": "raw",
              "raw": "{",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Empty edit",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/slots/{{knownSlotId}}",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
